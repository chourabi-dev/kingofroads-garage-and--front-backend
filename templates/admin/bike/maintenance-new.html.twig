{% extends '@EasyAdmin/page/content.html.twig' %}

{% macro line_row(f) %}
    {% set type = f.product.vars.data ? 'product' : 'action' %}
    <div class="maintenance-line row g-2 align-items-end border rounded p-2 mb-2" data-type="{{ type }}">
        <div class="col-12 col-md-5 line-col-action {{ type == 'product' ? 'd-none' : '' }}">
            <label class="form-label small mb-1"><span class="badge bg-secondary">Action</span></label>
            {{ form_widget(f.action) }}
            {{ form_errors(f.action) }}
        </div>
        <div class="col-12 col-md-5 line-col-product {{ type == 'action' ? 'd-none' : '' }}">
            <label class="form-label small mb-1"><span class="badge bg-info text-dark">Product</span></label>
            {{ form_widget(f.product) }}
            {{ form_errors(f.product) }}
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Quantity</label>
            {{ form_widget(f.quantity) }}
            {{ form_errors(f.quantity) }}
        </div>
        <div class="col-6 col-md-2">
            <label class="form-label small mb-1">Unit price (TND)</label>
            {{ form_widget(f.price) }}
            {{ form_errors(f.price) }}
        </div>
        <div class="col-8 col-md-2 text-md-end">
            <div class="small text-muted">Line total</div>
            <strong class="line-total">0.000</strong>
        </div>
        <div class="col-4 col-md-1 text-end">
            <button type="button" class="btn btn-outline-danger btn-sm remove-line" title="Remove line"><i class="fa fa-trash"></i></button>
        </div>
    </div>
{% endmacro %}

{% block head_stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/select2-bootstrap-5-theme@1.3.0/dist/select2-bootstrap-5-theme.min.css">
{% endblock %}

{% block content_title %}New maintenance — {{ bike.make.label }} {{ bike.model }} ({{ bike.plate }}){% endblock %}

{% block main %}
    {% import _self as m %}
    {{ form_start(form) }}
    <div class="card mb-3">
        <div class="card-body">
            {{ form_errors(form) }}

            <div class="mb-4">
                <label class="form-label fw-bold" for="{{ form.note.vars.id }}">Note</label>
                {{ form_widget(form.note) }}
                {{ form_errors(form.note) }}
            </div>

            <div class="mb-4">
                <label class="form-label fw-bold" for="{{ form.odometer.vars.id }}">Odometer (km)</label>
                {{ form_widget(form.odometer) }}
                {{ form_errors(form.odometer) }}
            </div>

            <div class="d-flex justify-content-between align-items-center mb-2">
                <label class="form-label fw-bold mb-0">Actions &amp; products</label>
                <div class="d-flex gap-2">
                    <button type="button" id="add-action" class="btn btn-sm btn-outline-primary"><i class="fa fa-plus"></i> Add action</button>
                    <button type="button" id="add-product" class="btn btn-sm btn-outline-info"><i class="fa fa-plus"></i> Add product</button>
                </div>
            </div>

            {{ form_errors(form.lines) }}

            <div id="lines"
                 data-index="{{ form.lines|length }}"
                 data-prototype="{{ m.line_row(form.lines.vars.prototype)|e('html_attr') }}">
                {% for f in form.lines %}
                    {{ m.line_row(f) }}
                {% endfor %}
            </div>

            <div class="text-end fs-5 mt-3">
                Total HT: <strong id="grand-total">0.000</strong> TND
            </div>
        </div>
    </div>

    <div class="d-flex gap-2">
        {{ form_widget(form.save) }}
        <a class="btn btn-secondary" href="{{ cancel_url }}">Cancel</a>
    </div>
    {{ form_end(form) }}

    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script>
        (function () {
            const container = document.getElementById('lines');
            const grand = document.getElementById('grand-total');

            function recompute() {
                let total = 0;
                container.querySelectorAll('.maintenance-line').forEach(function (row) {
                    const qty = parseFloat(row.querySelector('.line-qty').value) || 0;
                    const price = parseFloat(row.querySelector('.line-price').value) || 0;
                    const lt = qty * price;
                    row.querySelector('.line-total').textContent = lt.toFixed(3);
                    total += lt;
                });
                grand.textContent = total.toFixed(3);
            }

            // Select2 is optional: if the CDN is unreachable we keep the plain <select>.
            const hasSelect2 = !!(window.jQuery && window.jQuery.fn && window.jQuery.fn.select2);

            function initSelect2(scope) {
                if (!hasSelect2) { return; }
                window.jQuery(scope).find('select.line-action, select.line-product').each(function () {
                    const $el = window.jQuery(this);
                    if ($el.hasClass('select2-hidden-accessible')) { return; }
                    $el.select2({
                        theme: 'bootstrap-5',
                        width: '100%',
                        placeholder: $el.hasClass('line-product') ? '— Select a product —' : '— Select an action —',
                        allowClear: true,
                    });
                });
            }

            // Pre-fill the unit price from the chosen action/product (data-price on the <option>).
            function onItemChanged(select) {
                const opt = select.selectedOptions[0];
                const row = select.closest('.maintenance-line');
                if (opt && opt.dataset.price !== undefined && opt.dataset.price !== '') {
                    row.querySelector('.line-price').value = parseFloat(opt.dataset.price).toFixed(3);
                }
                recompute();
            }

            // A row is either an action or a product: show the matching select, hide + clear the other one,
            // so only one of them is ever submitted.
            function applyType(row, type) {
                row.dataset.type = type;
                const isProduct = type === 'product';
                row.querySelector('.line-col-action').classList.toggle('d-none', isProduct);
                row.querySelector('.line-col-product').classList.toggle('d-none', !isProduct);
                const other = row.querySelector(isProduct ? 'select.line-action' : 'select.line-product');
                other.value = '';
                if (window.jQuery) { window.jQuery(other).trigger('change.select2'); }
            }

            function addLine(type) {
                const index = parseInt(container.dataset.index, 10);
                container.dataset.index = index + 1;
                const html = container.dataset.prototype.replace(/__name__/g, index);
                const wrapper = document.createElement('div');
                wrapper.innerHTML = html.trim();
                const row = wrapper.firstElementChild;
                row.querySelector('.line-qty').value = 1;
                applyType(row, type);
                container.appendChild(row);
                initSelect2(row);
                recompute();
            }

            document.getElementById('add-action').addEventListener('click', function () { addLine('action'); });
            document.getElementById('add-product').addEventListener('click', function () { addLine('product'); });

            container.addEventListener('click', function (e) {
                const btn = e.target.closest('.remove-line');
                if (btn) {
                    btn.closest('.maintenance-line').remove();
                    recompute();
                }
            });

            container.addEventListener('change', function (e) {
                if (e.target.classList.contains('line-action') || e.target.classList.contains('line-product')) {
                    onItemChanged(e.target);
                } else {
                    recompute();
                }
            });

            // Select2 fires jQuery events (not native ones), so listen to those as well.
            if (hasSelect2) {
                window.jQuery(container).on('select2:select select2:clear', '.line-action, .line-product', function () {
                    onItemChanged(this);
                });
            }
            container.addEventListener('input', recompute);

            initSelect2(container);

            if (container.querySelectorAll('.maintenance-line').length === 0) {
                addLine('action');
            } else {
                recompute();
            }
        })();
    </script>
{% endblock %}
